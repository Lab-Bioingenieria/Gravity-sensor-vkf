/*
 * ESP32-S3 RECEIVER
 *
 * ESP-NOW -> Dashboard web
 *
 * Compatible con el transmisor C3 actual:
 *
 * typedef struct {
 *     float ch0;
 *     float ch1;
 *     float ch2;
 * } EMGData;
 *
 * Tamaño del paquete: 12 bytes.
 *
 * SERIAL:
 *   Solo números para Serial Plotter:
 *
 *   ch0    ch1    ch2
 *
 *   Ejemplo:
 *   0.123  0.087  0.241
 *
 * No se imprimen etiquetas, textos ni contadores durante
 * la recepción de datos.
 *
 * DASHBOARD:
 *   http://192.168.4.1
 *
 * WIFI:
 *   SSID: EMG-Dashboard
 *   Password: emg12345
 *
 * CANAL:
 *   1
 */

#include <Arduino.h>
#include <WiFi.h>
#include <esp_now.h>
#include <WebServer.h>


// ================================================================
// WIFI ACCESS POINT
// ================================================================

const char *AP_SSID = "EMG-Dashboard";

const char *AP_PASSWORD = "emg12345";

const uint8_t AP_CHANNEL = 1;


// ================================================================
// ESTRUCTURA EXACTAMENTE IGUAL AL TRANSMISOR
// ================================================================

typedef struct {

    float ch0;

    float ch1;

    float ch2;

} EMGData;

typedef struct {

    uint8_t type;

    uint8_t channel;

    float rest;

    float mvc;

    float onset;

} CalibrationData;

enum CalibrationEvent : uint8_t {
    CAL_START_REST = 1,
    CAL_REST_DONE  = 2,
    CAL_START_MVC  = 3,
    CAL_CHANNEL_DONE = 4,
    CAL_FAILED = 5,
    CAL_DONE = 6
};


// ================================================================
// DATOS EMG
// ================================================================

volatile float ch0 = 0.0f;

volatile float ch1 = 0.0f;

volatile float ch2 = 0.0f;

volatile bool calibrating = false;
volatile uint8_t calibrationType = 0;
volatile uint8_t calibrationChannel = 0;
volatile float calibrationRest = 0.0f;
volatile float calibrationMvc = 0.0f;
volatile float calibrationOnset = 0.0f;


// ================================================================
// SERVIDOR WEB
// ================================================================

WebServer server(80);


