// ================================================================
// CALLBACK ESP-NOW
// ================================================================

void OnDataRecv(
    const uint8_t *mac,
    const uint8_t *data,
    int len
) {

    // ============================================================
    // PAQUETE EMG NORMAL: 12 bytes
    // ============================================================
    if (len == sizeof(EMGData)) {

        EMGData receivedData;

        memcpy(
            &receivedData,
            data,
            sizeof(receivedData)
        );

        ch0 = receivedData.ch0;
        ch1 = receivedData.ch1;
        ch2 = receivedData.ch2;

        // Mantener Serial Plotter limpio.
        Serial.print(ch0, 3);
        Serial.print('\t');
        Serial.print(ch1, 3);
        Serial.print('\t');
        Serial.println(ch2, 3);

        return;
    }

    // ============================================================
    // PAQUETE DE CALIBRACIÓN: sizeof(CalibrationData)
    // ============================================================
    if (len == sizeof(CalibrationData)) {

        CalibrationData receivedCalibration;

        memcpy(
            &receivedCalibration,
            data,
            sizeof(receivedCalibration)
        );

        calibrationType = receivedCalibration.type;
        calibrationChannel = receivedCalibration.channel;
        calibrationRest = receivedCalibration.rest;
        calibrationMvc = receivedCalibration.mvc;
        calibrationOnset = receivedCalibration.onset;

        if (calibrationType == CAL_DONE) {
            calibrating = false;
        } else {
            calibrating = true;
        }

        return;
    }
}


// ================================================================
// PÁGINA PRINCIPAL
// ================================================================

void handleRoot() {

    server.send_P(
        200,
        "text/html",
        DASHBOARD_HTML
    );

}


// ================================================================
// DATOS PARA EL DASHBOARD
// ================================================================

void handleData() {

    char json[384];

    float localCh0 = ch0;
    float localCh1 = ch1;
    float localCh2 = ch2;
    bool localCalibrating = calibrating;
    uint8_t localType = calibrationType;
    uint8_t localChannel = calibrationChannel;
    float localRest = calibrationRest;
    float localMvc = calibrationMvc;
    float localOnset = calibrationOnset;

    char message[180] = "";

    switch (localType) {
        case CAL_START_REST:
            snprintf(message, sizeof(message),
                     "Paso 1/2: relaja todos los músculos y mantente quieto. Midiendo reposo.");
            break;

        case CAL_REST_DONE:
            snprintf(message, sizeof(message),
                     "Reposo capturado. Preparando la calibración de fuerza.");
            break;

        case CAL_START_MVC:
            snprintf(message, sizeof(message),
                     "Paso 2/2: contrae con fuerza el músculo del canal %u.",
                     (unsigned)localChannel);
            break;

        case CAL_CHANNEL_DONE:
            snprintf(message, sizeof(message),
                     "Canal %u calibrado. Rest: %.2f | MVC: %.2f | Umbral: %.2f",
                     (unsigned)localChannel,
                     localRest, localMvc, localOnset);
            break;

        case CAL_FAILED:
            snprintf(message, sizeof(message),
                     "Canal %u: no se detectó contracción. Revisa los electrodos y reintenta.",
                     (unsigned)localChannel);
            break;

        default:
            snprintf(message, sizeof(message), "Calibrando...");
            break;
    }

    snprintf(
        json,
        sizeof(json),
        "{\"ch0\":%.3f,\"ch1\":%.3f,\"ch2\":%.3f,\"calibrating\":%s,\"calibrationMessage\":\"%s\"}",
        localCh0,
        localCh1,
        localCh2,
        localCalibrating ? "true" : "false",
        message
    );

    server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
    server.sendHeader("Pragma", "no-cache");
    server.sendHeader("Expires", "0");

    server.send(
        200,
        "application/json",
        json
    );
}



// ================================================================
// SETUP
// ================================================================

void setup() {

    Serial.begin(
        115200
    );


    delay(1000);


    // ============================================================
    // WIFI
    // ============================================================

    WiFi.mode(
        WIFI_AP_STA
    );


    // ============================================================
    // ACCESS POINT
    // ============================================================

    WiFi.softAP(
        AP_SSID,
        AP_PASSWORD,
        AP_CHANNEL
    );


    // ============================================================
    // ESP-NOW
    // ============================================================

    if (
        esp_now_init() != ESP_OK
    ) {

        return;

    }


    // ============================================================
    // CALLBACK
    // ============================================================

    esp_now_register_recv_cb(
        OnDataRecv
    );


    // ============================================================
    // SERVIDOR WEB
    // ============================================================

    server.on(
        "/",
        HTTP_GET,
        handleRoot
    );


    server.on(
        "/data",
        HTTP_GET,
        handleData
    );


    server.begin();


    // ============================================================
    // IMPORTANTE:
    //
    // DESPUÉS DE AQUÍ NO SE IMPRIMEN MENSAJES DE TEXTO.
    //
    // El Serial queda reservado para Serial Plotter.
    // ============================================================

}


// ================================================================
// LOOP
// ================================================================

void loop() {

    server.handleClient();

}