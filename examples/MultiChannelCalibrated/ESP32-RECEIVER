<script>


// ============================================================
// CONFIGURACIÓN
// ============================================================

const MAX_POINTS = 100;

const POLL_MS = 100;


// ============================================================
// BUFFERS
// ============================================================

const buffers = [

    new Array(MAX_POINTS).fill(0),

    new Array(MAX_POINTS).fill(0),

    new Array(MAX_POINTS).fill(0)

];


const colors = [

    '#38bdf8',

    '#fbbf24',

    '#a78bfa'

];


const canvases = [

    document.getElementById('c0'),

    document.getElementById('c1'),

    document.getElementById('c2')

];


const valEls = [

    document.getElementById('v0'),

    document.getElementById('v1'),

    document.getElementById('v2')

];


// ============================================================
// DIBUJAR GRÁFICA
// ============================================================

function drawChart(canvas, data, color) {

    const ctx =
        canvas.getContext('2d');


    const w =
        canvas.width;


    const h =
        canvas.height;


    ctx.clearRect(
        0,
        0,
        w,
        h
    );


    // --------------------------------------------------------
    // GRID
    // --------------------------------------------------------

    ctx.strokeStyle =
        '#2a2a2a';


    ctx.lineWidth = 1;


    for (
        let g = 0;
        g <= 4;
        g++
    ) {

        const y =
            (h / 4) * g;


        ctx.beginPath();


        ctx.moveTo(
            0,
            y
        );


        ctx.lineTo(
            w,
            y
        );


        ctx.stroke();

    }


    // --------------------------------------------------------
    // LÍNEA DE DATOS
    // --------------------------------------------------------

    ctx.strokeStyle =
        color;


    ctx.lineWidth = 2;


    ctx.beginPath();


    const stepX =
        w / (MAX_POINTS - 1);


    data.forEach(
        (v, i) => {

            const x =
                i * stepX;


            const clamped =
                Math.max(
                    0,
                    Math.min(
                        1,
                        v
                    )
                );


            const y =
                h -
                clamped * h;


            if (i === 0) {

                ctx.moveTo(
                    x,
                    y
                );

            } else {

                ctx.lineTo(
                    x,
                    y
                );

            }

        }
    );


    ctx.stroke();


    // --------------------------------------------------------
    // RELLENO
    // --------------------------------------------------------

    ctx.lineTo(
        w,
        h
    );


    ctx.lineTo(
        0,
        h
    );


    ctx.closePath();


    ctx.fillStyle =
        color + '22';


    ctx.fill();

}


// ============================================================
// AGREGAR VALOR
// ============================================================

function pushValue(idx, val) {

    if (
        !Number.isFinite(val)
    ) {

        val = 0;

    }


    buffers[idx].push(
        val
    );


    if (
        buffers[idx].length >
        MAX_POINTS
    ) {

        buffers[idx].shift();

    }


    drawChart(

        canvases[idx],

        buffers[idx],

        colors[idx]

    );


    valEls[idx].textContent =
        val.toFixed(3);

}


// ============================================================
// ELEMENTOS DEL DASHBOARD
// ============================================================

const connEl =
    document.getElementById(
        'conn'
    );

const calibrationCard =
    document.getElementById(
        'calibrationCard'
    );

const calibrationMessage =
    document.getElementById(
        'calibrationMessage'
    );


// ============================================================
// CONSULTAR DATOS
// ============================================================

async function poll() {

    try {

        const response =
            await fetch(
                '/data',
                {
                    cache: 'no-store'
                }
            );


        if (!response.ok) {

            throw new Error(
                'HTTP ' +
                response.status
            );

        }


        const d =
            await response.json();


        // ====================================================
        // ACTUALIZAR LA CALIBRACIÓN (SOLO CUANDO ESTÁ ACTIVA)
        // ====================================================

        if (d.calibrating) {
            calibrationCard.style.display = 'block';
            calibrationMessage.textContent = d.calibrationMessage;
        } else {
            calibrationCard.style.display = 'none';
        }

        // ====================================================
        // ACTUALIZAR LAS 3 GRÁFICAS
        // ====================================================

        pushValue(
            0,
            d.ch0
        );


        pushValue(
            1,
            d.ch1
        );


        pushValue(
            2,
            d.ch2
        );


        // ====================================================
        // CONEXIÓN
        // ====================================================

        connEl.textContent =
            'conectado';


        connEl.className =
            'ok';


    } catch (error) {

        connEl.textContent =
            'sin conexión, reintentando...';


        connEl.className =
            'bad';

    }


    setTimeout(
        poll,
        POLL_MS
    );

}


// ============================================================
// INICIAR DASHBOARD
// ============================================================

poll();


</script>


